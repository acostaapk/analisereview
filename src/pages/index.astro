---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const reviews = await getCollection('reviews');
const featured = reviews[0];
---

<Base title="Maquininha Ton: análise de parceiro" description="Análise honesta da maquininha Ton: taxas, garantia e para quem vale a pena. Parceiro Renda Ton.">
  <section class="hero">
    <span class="eyebrow">Análises de maquininhas</span>
    <h1>A maquininha Ton, analisada sem hype.</h1>
    <p class="dek">Somos Parceiro Renda Ton. Analisamos com base em dados públicos — taxas, aluguel, garantia e reputação — para você decidir com evidência, não com promessa.</p>
  </section>

  <section class="featured">
    <h2 class="section-label">Análise em destaque</h2>
    <a class="feature-card" href={`/reviews/${featured.slug}`}>
      {featured.data.image && <img src={featured.data.image} alt="" />}
      <div class="feature-body">
        <span class="badge">Nota {featured.data.score}/10</span>
        <h3>{featured.data.title}</h3>
        <p>{featured.data.description}</p>
        <span class="more">Ler a análise →</span>
      </div>
    </a>
  </section>

  <section class="method">
    <h2 class="section-label">Como analisamos</h2>
    <ol class="steps">
      <li><strong>Coletamos dados públicos</strong> na data da análise: taxas, garantia, modelos e reputação.</li>
      <li><strong>Pontuamos com critérios documentados</strong> — taxas, suporte, garantia e custo-benefício.</li>
      <li><strong>Publicamos prós, contras e veredito</strong>, sem prometer resultado.</li>
    </ol>
    <a class="method-link" href="/metodologia">Ver metodologia completa</a>
  </section>
</Base>

<style>
  .hero, .featured, .method { max-width: var(--measure); margin: 0 auto; padding: var(--space-5) var(--space-4); }
  .hero { padding-top: var(--space-6); }
  .eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent); font-weight: 600; }
  .hero h1 { font-size: clamp(2.5rem, 6vw, 4rem); margin: var(--space-3) 0; }
  .dek { font-size: 1.375rem; font-style: italic; color: var(--color-muted); max-width: 45ch; margin: 0; }
  .section-label { font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); border-bottom: 2px solid var(--color-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-4); }
  .feature-card { display: grid; grid-template-columns: 9rem 1fr; gap: var(--space-5); align-items: center; text-decoration: none; color: inherit; border: 2px solid var(--color-ink); padding: var(--space-4); background: var(--color-surface); transition: transform 0.15s ease; }
  .feature-card:hover { transform: translateY(-2px); }
  .feature-card img { width: 100%; height: auto; }
  .badge { display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px var(--space-2); border: 2px solid var(--color-good); color: var(--color-good); }
  .feature-body h3 { font-size: 1.5rem; margin: var(--space-2) 0; }
  .feature-body p { margin: 0 0 var(--space-2); color: var(--color-muted); }
  .more { color: var(--color-accent); font-weight: 600; }
  .steps { list-style: none; counter-reset: step; padding: 0; margin: 0 0 var(--space-4); }
  .steps li { counter-increment: step; padding: var(--space-3) 0 var(--space-3) var(--space-6); border-top: 1px solid var(--color-rule); position: relative; }
  .steps li::before { content: counter(step); position: absolute; left: 0; top: var(--space-3); font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--color-accent); }
  .method-link { font-weight: 600; }
  @media (max-width: 640px) {
    .feature-card { grid-template-columns: 1fr; }
    .feature-card img { max-width: 8rem; }
  }
</style>
