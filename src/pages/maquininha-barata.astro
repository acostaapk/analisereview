---
import Guide from '../layouts/Guide.astro';
import { updatedAt } from '../data/site';

const title = 'Maquininha com adesão única e sem mensalidade: entenda o custo';
const description = 'Compare o custo real da maquininha Ton: taxa única de adesão, sem cobrança fixa mensal e taxas promocionais para novos clientes. Veja as condições.';
const faqs = [
  {
    q: 'Quanto custa a maquininha Ton?',
    a: 'Os modelos têm valores de adesão à vista: T1 R$ 16,80, T2 R$ 49,88, T3 R$ 108,00 e T3 Smart R$ 191,88 (catálogo em 06/10/2026). A adesão pode ser parcelada em até 12x.',
  },
  {
    q: 'Tem taxa mensal ou aluguel?',
    a: 'Não. Você paga uma taxa única de adesão e, depois, não há cobrança fixa mensal. A tarifa por venda varia conforme a modalidade e a faixa de vendas.',
  },
  {
    q: 'O que muda depois da promoção?',
    a: 'A promoção vale por 30 dias ou até R$ 5 mil em vendas. Depois, as taxas seguem a sua faixa de vendas mensais, calculada pelo volume do mês anterior.',
  },
  {
    q: 'O Pix é grátis?',
    a: 'Sim, mantendo uma chave Pix cadastrada na Conta Ton. Sem a chave, a taxa é de 0,49% por venda.',
  },
];
---

<Guide
  title={title}
  description={description}
  canonicalUrl="https://analisereview.com.br/maquininha-barata/"
  eyebrow="Maquininha Ton · entenda o custo"
  faqs={faqs}
  breadcrumbName="Custo da maquininha"
>
  <div class="tldr">
    <strong>Em resumo:</strong> na Ton você paga uma <strong>taxa única de
    adesão</strong> e não tem cobrança fixa por mês. Compare o custo real no
    simulador oficial antes de decidir — cada negócio tem uma faixa de vendas e
    uma tabela de taxas próprias. Dados consultados em {updatedAt}.
  </div>

  <figure class="figure">
    <img src="/ilustra-recebimento.webp" alt="Ilustração da maquininha Ton com representação de recebimento" width="614" height="770" loading="lazy" />
    <figcaption>Entenda o custo e o recebimento na maquininha Ton.</figcaption>
  </figure>

  <h2>Estrutura de custo da maquininha Ton</h2>
  <ul>
    <li><strong>Adesão única</strong> — valor à vista por modelo, parcelável em até 12x.</li>
    <li><strong>Sem mensalidade e sem aluguel</strong> — depois da adesão, não há cobrança fixa.</li>
    <li><strong>Tarifa por venda</strong> — varia por modalidade, parcelas, bandeira e prazo de recebimento.</li>
    <li><strong>Faixa de vendas</strong> — depois da promoção, o volume do mês anterior define a tabela.</li>
  </ul>

  <h2>Valores de adesão por modelo</h2>
  <table class="rates-table">
    <thead>
      <tr><th scope="col">Modelo</th><th scope="col">À vista</th><th scope="col">Parcelamento</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">T1</th><td>R$ 16,80</td><td>até 12x</td></tr>
      <tr><th scope="row">T2</th><td>R$ 49,88</td><td>até 12x</td></tr>
      <tr><th scope="row">T3</th><td>R$ 108,00</td><td>até 21x</td></tr>
      <tr><th scope="row">T3 Smart</th><td>R$ 191,88</td><td>até 21x</td></tr>
    </tbody>
  </table>
  <p class="rates-note">Valores à vista do catálogo da Ton em {updatedAt} e podem mudar. O parcelamento até 21x vale para novos clientes nos modelos T3 e T3 Smart.</p>

  <h2>Taxas promocionais para novos clientes</h2>
  <table class="rates-table">
    <thead>
      <tr><th scope="col">Modalidade</th><th scope="col">Taxa</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">Débito</th><td class="rate-promo">0,74%*</td></tr>
      <tr><th scope="row">Crédito à vista</th><td class="rate-promo">0,74%*</td></tr>
      <tr><th scope="row">Crédito em 12x</th><td class="rate-promo">no app*</td></tr>
      <tr><th scope="row">Crédito em 21x</th><td class="rate-promo">no app*</td></tr>
    </tbody>
  </table>
  <p class="rates-note">Maquininhas · Mastercard e Visa · recebimento em 1 dia útil · Planos Mega+ e Black · *a partir de · confirme no app · consulta em {updatedAt}.</p>

  <details class="conditions">
    <summary>Como comparar sem erro</summary>
    <ul>
      <li>Não compare só o preço de adesão: avalie a tarifa por venda no seu cenário.</li>
      <li>Use o simulador oficial para ver o valor líquido de cada venda.</li>
      <li>Considere a faixa de vendas que se aplica depois da promoção.</li>
    </ul>
  </details>
</Guide>

<style>
  .tldr {
    border-left: 4px solid var(--color-ton);
    background: var(--color-surface);
    padding: var(--space-4);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 1.0625rem;
  }
  .tldr strong { font-weight: 700; }
</style>
