---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Scorecard from '../../components/Scorecard.astro';
import DataTable from '../../components/DataTable.astro';
import ProsCons from '../../components/ProsCons.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((r) => ({ params: { slug: r.slug }, props: { review: r } }));
}

const { review } = Astro.props;
const { Content } = await review.render();
const { title, product, company, price, priceCurrency, reviewCount, score, subscores, pros, cons, verdict, recommended, affiliateUrl, updatedAt, category, description, image } = review.data;

const adesao = price > 0
  ? price.toLocaleString('pt-BR', { style: 'currency', currency: priceCurrency })
  : 'Taxa única de adesão (sem mensalidade)';
const rows = [
  { label: 'Adesão', value: adesao },
  { label: 'Usuários', value: reviewCount.toLocaleString('pt-BR') },
  { label: 'Empresa', value: company },
  { label: 'Atualizado em', value: updatedAt },
];
---

<Base title={title} description={description}>
  <article>
    <header class="review-hero">
      <div class="hero-copy">
        <span class="eyebrow">Análise · {category}</span>
        <h1>{title}</h1>
        <p class="dek">{description}</p>
        <p class="hero-meta"><span class={`badge ${recommended ? 'ok' : 'no'}`}>{recommended ? 'Recomendado' : 'Não recomendado'}</span> Atualizado em {updatedAt}</p>
      </div>
      {image && <img class="hero-img" src={image} alt={`Imagem ilustrativa da ${product}`} />}
    </header>

    <Scorecard score={score} subscores={subscores} />

    <h2 class="section-title">Ficha do produto</h2>
    <DataTable rows={rows} />

    <ProsCons pros={pros} cons={cons} />

    <div class="body">
      <Content />
    </div>

    <VerdictBox verdict={verdict} recommended={recommended} score={score} />
    <AffiliateCTA href={affiliateUrl} product={product} />
  </article>
</Base>

<style>
  article { max-width: var(--measure); margin: 0 auto; padding: var(--space-4); }
  .review-hero { display: grid; grid-template-columns: 1fr 13rem; gap: var(--space-6); align-items: start; padding-bottom: var(--space-5); margin-bottom: var(--space-3); border-bottom: 2px solid var(--color-ink); }
  .eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent); font-weight: 600; }
  h1 { font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 1.05; margin: var(--space-2) 0 var(--space-3); }
  .dek { font-size: 1.25rem; font-style: italic; color: var(--color-muted); margin: 0 0 var(--space-3); }
  .hero-meta { color: var(--color-muted); display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .badge { display: inline-block; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.8125rem; padding: var(--space-1) var(--space-2); border: 2px solid; }
  .badge.ok { color: var(--color-good); border-color: var(--color-good); }
  .badge.no { color: var(--color-accent); border-color: var(--color-accent); }
  .hero-img { width: 100%; height: auto; border: 1px solid var(--color-rule); background: var(--color-surface); }
  .section-title { font-size: 1.5rem; margin: var(--space-6) 0 var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-rule); }
  .body { margin-top: var(--space-6); }
  @media (max-width: 640px) {
    .review-hero { grid-template-columns: 1fr; }
    .hero-img { max-width: 12rem; }
  }
</style>
