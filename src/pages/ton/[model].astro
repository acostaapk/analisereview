---
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import { models } from '../../data/models';
import { siteBase } from '../../data/site';

export function getStaticPaths() {
  return models.map((m) => ({ params: { model: m.id } }));
}

const { model } = Astro.params;
const m = models.find((x) => x.id === model);
if (!m) return Astro.redirect('/');

const imageUrl = `${siteBase}${m.image}`;
const title = m.name;
const canonicalUrl = `${siteBase}/ton/${m.id}/`;

const productData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: m.name,
    image: imageUrl,
    description: m.desc,
    offers: {
      '@type': 'Offer',
      price: (m.price || '').replace(/[^\d,]/g, '').replace(',', '.'),
      priceCurrency: 'BRL',
      availability: 'https://schema.org/InStock',
    },
  },
];
---

<Base title={title} description={m.desc} ogImage={imageUrl} canonicalUrl={canonicalUrl}>
  <JsonLd data={productData} />
  <section class="section section-alt">
    <div class="wrap">
      <article class="model-card product-single">
        <div class="model-media">
          <img src={m.image} alt={m.name} width="342" height="255" />
        </div>
        <div class="model-body">
          <span class="eyebrow">Maquininha Ton</span>
          <h1>{m.name}</h1>
          <div class="model-tags">
            {m.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <p class="model-desc">{m.desc}</p>
          <p class="model-price">
            <span class="price-value">{m.price}</span>
            <span class="price-installment">{m.installment}</span>
            <small>{m.maxInstallments} · catálogo em 06/10/2026</small>
          </p>
          <a class="btn btn-primary" href={m.checkoutUrl} rel="nofollow sponsored" target="_blank">Comprar no site oficial da Ton</a>
          <a class="btn btn-whatsapp" href={m.whatsappUrl} target="_blank" rel="noopener">Tirar dúvidas no WhatsApp</a>
        </div>
      </article>
      <p class="section-note">Valores à vista exibidos no catálogo da Ton em 06/10/2026 e podem mudar. Confira as condições atuais ao pedir.</p>
    </div>
  </section>
</Base>

<style>
  .product-single { max-width: 520px; margin-inline: auto; }
  .product-single h1 { margin: var(--space-1) 0 var(--space-2); text-transform: uppercase; }
  .product-single .model-body .btn { display: block; width: 100%; text-align: center; }
</style>
