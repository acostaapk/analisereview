---
interface Props { pros: string[]; cons: string[] }
const { pros, cons } = Astro.props;
---

<div class="proscons">
  <div class="col pros">
    <h3>Prós</h3>
    <ul>{pros.map((p) => <li>{p}</li>)}</ul>
  </div>
  <div class="col cons">
    <h3>Contras</h3>
    <ul>{cons.map((c) => <li>{c}</li>)}</ul>
  </div>
</div>

<style>
  .proscons { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin: var(--space-5) 0; }
  .col { border: 1px solid var(--color-rule); padding: var(--space-4); background: var(--color-surface); }
  .col h3 { margin: 0 0 var(--space-3); font-size: 1.25rem; }
  .pros h3 { color: var(--color-good); }
  .cons h3 { color: var(--color-accent); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: var(--space-2) 0; border-top: 1px solid var(--color-rule); }
  li:first-child { border-top: 0; }
  .pros li::before { content: '+ '; color: var(--color-good); font-weight: 700; }
  .cons li::before { content: '– '; color: var(--color-accent); font-weight: 700; }
  @media (max-width: 640px) { .proscons { grid-template-columns: 1fr; } }
</style>
