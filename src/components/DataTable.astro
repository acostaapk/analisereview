---
interface Props { rows: { label: string; value: string }[] }
const { rows } = Astro.props;
---

<table>
  <caption class="sr-only">Ficha do produto</caption>
  <tbody>
    {rows.map((r) => (
      <tr><th scope="row">{r.label}</th><td>{r.value}</td></tr>
    ))}
  </tbody>
</table>

<style>
  table { width: 100%; border-collapse: collapse; font-size: 1rem; border: 1px solid var(--color-rule); }
  th, td { text-align: left; padding: var(--space-3); border-bottom: 1px solid var(--color-rule); }
  th { font-weight: 600; width: 40%; color: var(--color-muted); font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.06em; }
  tbody tr:nth-child(odd) { background: var(--color-surface); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
</style>
