---
---
<div id="cookie-banner" class="cookie-banner" hidden>
  <div class="cookie-card" role="dialog" aria-labelledby="cookie-title" aria-modal="false">
    <div class="cookie-top">
      <h2 id="cookie-title">Cookies e privacidade</h2>
      <p>Usamos cookies necessários para o site funcionar e, com o seu consentimento, cookies analíticos e de marketing. <a href="/privacidade">Saiba mais na Política de Privacidade</a>.</p>
    </div>

    <details class="cookie-details">
      <summary>Personalizar</summary>
      <form id="cookie-form">
        <label class="cookie-row">
          <input type="checkbox" checked disabled />
          <span><strong>Necessários</strong> — essenciais para o funcionamento.</span>
        </label>
        <label class="cookie-row">
          <input type="checkbox" name="analytics" />
          <span><strong>Analíticos</strong> — medem o uso do site.</span>
        </label>
        <label class="cookie-row">
          <input type="checkbox" name="marketing" />
          <span><strong>Marketing</strong> — personalização e anúncios.</span>
        </label>
        <button type="button" class="cookie-save" id="cookie-save">Salvar preferências</button>
      </form>
    </details>

    <div class="cookie-actions">
      <button type="button" id="cookie-reject">Rejeitar</button>
      <button type="button" id="cookie-accept">Aceitar todos</button>
    </div>
  </div>
</div>

<script>
  const KEY = 'cookieConsent';

  interface Consent {
    necessary: boolean;
    analytics: boolean;
    marketing: boolean;
  }

  function readConsent(): Consent | null {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? 'null') as Consent | null;
    } catch {
      return null;
    }
  }

  function writeConsent(value: Consent) {
    localStorage.setItem(KEY, JSON.stringify(value));
    const el = document.getElementById('cookie-banner');
    if (el) el.hidden = true;
  }

  const banner = document.getElementById('cookie-banner');
  if (!readConsent() && banner) {
    banner.hidden = false;
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    writeConsent({ necessary: true, analytics: true, marketing: true });
  });

  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    writeConsent({ necessary: true, analytics: false, marketing: false });
  });

  document.getElementById('cookie-save')?.addEventListener('click', () => {
    const form = document.getElementById('cookie-form') as HTMLFormElement | null;
    if (!form) return;
    const data = new FormData(form);
    writeConsent({
      necessary: true,
      analytics: data.has('analytics'),
      marketing: data.has('marketing'),
    });
  });
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: var(--space-3);
  }
  .cookie-card {
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-top: 4px solid var(--color-ton);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    width: 100%;
    max-width: 46rem;
    max-height: 72vh;
    overflow-y: auto;
    box-shadow: 0 -6px 24px rgba(8, 19, 12, 0.16);
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }
  .cookie-card h2 { font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 var(--space-1); }
  .cookie-card p { margin: 0; color: var(--color-muted); }
  .cookie-top { display: grid; gap: var(--space-1); }
  .cookie-details { margin-top: var(--space-2); }
  .cookie-details summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--color-ton-dark);
    font-size: 0.9375rem;
    list-style: none;
  }
  .cookie-details summary::-webkit-details-marker { display: none; }
  .cookie-details[open] { border-top: 1px solid var(--color-rule); padding-top: var(--space-2); }
  .cookie-row { display: flex; gap: var(--space-2); align-items: flex-start; padding: var(--space-1) 0; font-size: 0.875rem; }
  .cookie-row:first-of-type { margin-top: var(--space-2); }
  .cookie-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  button {
    font-family: var(--font-body);
    padding: 0.65rem 1.25rem;
    cursor: pointer;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9375rem;
  }
  #cookie-accept { background: var(--color-ton); color: var(--color-ink); border: 2px solid var(--color-ton); }
  #cookie-reject { background: transparent; color: var(--color-ink); border: 1px solid var(--color-ink); }
  .cookie-save { background: transparent; color: var(--color-ton-dark); border: 1px solid var(--color-ton-dark); margin-top: var(--space-2); padding: 0.5rem 1rem; }
</style>
