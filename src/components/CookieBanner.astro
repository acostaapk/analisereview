---
---
<div id="cookie-banner" class="cookie-banner" hidden>
  <div class="cookie-card" role="dialog" aria-labelledby="cookie-title" aria-modal="false">
    <h2 id="cookie-title">Cookies e privacidade</h2>
    <p>Usamos cookies necessários para o site funcionar e, com o seu consentimento, cookies analíticos e de marketing.</p>

    <form id="cookie-form">
      <label class="cookie-row">
        <input type="checkbox" checked disabled />
        <span><strong>Necessários</strong> — essenciais para o funcionamento.</span>
      </label>
      <label class="cookie-row">
        <input type="checkbox" name="analytics" />
        <span><strong>Analíticos</strong> — medem o uso do site.</span>
      </label>
      <label class="cookie-row">
        <input type="checkbox" name="marketing" />
        <span><strong>Marketing</strong> — personalização e anúncios.</span>
      </label>

      <div class="cookie-actions">
        <button type="button" id="cookie-reject">Rejeitar</button>
        <button type="button" id="cookie-save">Salvar preferências</button>
        <button type="button" id="cookie-accept">Aceitar todos</button>
      </div>
    </form>
  </div>
</div>

<script>
  const KEY = 'cookieConsent';

  function readConsent() {
    try {
      return JSON.parse(localStorage.getItem(KEY));
    } catch {
      return null;
    }
  }

  function writeConsent(value) {
    localStorage.setItem(KEY, JSON.stringify(value));
    document.getElementById('cookie-banner').hidden = true;
  }

  const banner = document.getElementById('cookie-banner');
  if (!readConsent()) {
    banner.hidden = false;
  }

  document.getElementById('cookie-accept').addEventListener('click', () => {
    writeConsent({ necessary: true, analytics: true, marketing: true });
  });

  document.getElementById('cookie-reject').addEventListener('click', () => {
    writeConsent({ necessary: true, analytics: false, marketing: false });
  });

  document.getElementById('cookie-save').addEventListener('click', () => {
    const form = document.getElementById('cookie-form');
    const data = new FormData(form);
    writeConsent({
      necessary: true,
      analytics: data.has('analytics'),
      marketing: data.has('marketing'),
    });
  });
</script>

<style>
  .cookie-banner { position: fixed; left: 0; right: 0; bottom: 0; z-index: 100; display: flex; justify-content: center; padding: var(--space-3); }
  .cookie-card { background: var(--color-paper); color: var(--color-ink); border: 2px solid var(--color-ink); border-bottom: 6px solid var(--color-accent); padding: var(--space-3) var(--space-4); width: 100%; max-width: 44rem; max-height: 80vh; overflow-y: auto; box-shadow: 0 -6px 24px rgba(26, 26, 26, 0.14); font-family: var(--font-body); font-size: 0.9375rem; }
  .cookie-card h2 { font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 var(--space-2); }
  .cookie-card p { margin: 0 0 var(--space-2); }
  .cookie-row { display: flex; gap: var(--space-2); align-items: flex-start; padding: var(--space-1) 0; border-top: 1px solid var(--color-rule); }
  .cookie-row:first-of-type { border-top: 0; }
  .cookie-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  button { font-family: var(--font-body); padding: var(--space-2) var(--space-3); cursor: pointer; border: 1px solid var(--color-ink); background: var(--color-surface); color: var(--color-ink); }
  #cookie-accept { background: var(--color-ink); color: var(--color-paper); }
  #cookie-reject { background: transparent; }
</style>
