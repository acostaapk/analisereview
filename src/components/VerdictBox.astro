---
interface Props { verdict: string; recommended: boolean; score: number }
const { verdict, recommended, score } = Astro.props;
const label = recommended ? 'Recomendado' : 'Não recomendado';
---

<div class="verdict">
  <span class="label">{label}</span>
  <span class="note">Nota {score}/10</span>
  <p class="text">{verdict}</p>
</div>

<style>
  .verdict { border: 2px solid var(--color-ink); border-top: 6px solid var(--color-accent); background: var(--color-surface); padding: var(--space-5); margin-top: var(--space-6); }
  .label { display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-accent); margin-right: var(--space-3); }
  .note { color: var(--color-muted); }
  .text { font-size: 1.25rem; margin: var(--space-3) 0 0; }
</style>
