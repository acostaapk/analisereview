---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { affiliateUrl } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
}
const { title, description, canonicalUrl } = Astro.props;
const site = (Astro.site ? Astro.site.toString() : 'https://analisereview.com.br').replace(/\/$/, '');
const path = Astro.url.pathname === '/' ? '' : Astro.url.pathname;
const pageUrl = canonicalUrl ?? `${site}${path}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — AnaliseReview</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/TonCondensedVF.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SharonSans.woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/">Analise<span>Review</span></a>
        <img src="/parceiro-ton.webp" alt="Parceiro Ton" class="partner-logo" width="534" height="188" />
        <nav class="header-nav">
          <a class="nav-link" href="/guias/modelos-ton/">Modelos</a>
          <a class="nav-link" href="/guias/taxas-ton/">Taxas</a>
          <a class="nav-link" href="/metodologia">Como analisamos</a>
          <a class="btn btn-primary header-cta" href={affiliateUrl} rel="nofollow sponsored" target="_blank">Pedir minha maquininha</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <img src="/parceiro-ton.webp" alt="Parceiro Ton" class="partner-logo" width="534" height="188" />
        <p class="legal">Declaramos, para todos os fins, que este canal é de titularidade de um Parceiro Renda Ton/Renda Extra, que oferece descontos para aquisição dos produtos e serviços do Ton. Este ambiente não se confunde com os canais oficiais do Ton.</p>
        <p><a href={affiliateUrl} rel="nofollow sponsored">Site oficial do Ton</a> · <a href={affiliateUrl} rel="nofollow sponsored">Simulador de taxas</a></p>
        <p class="footer-links"><a href="/privacidade">Política de Privacidade</a> · <a href="/termos">Termos de Uso</a> · <a href="/contato">Contato</a></p>
        <p class="copyright">© {new Date().getFullYear()} AnaliseReview — Guia de escolha da maquininha Ton.</p>
      </div>
    </footer>
    <a id="share-fab" class="share-fab" href="#" aria-label="Compartilhar esta página no WhatsApp">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
    <script>
      const shareFab = document.getElementById('share-fab');
      if (shareFab) {
        shareFab.addEventListener('click', (event) => {
          event.preventDefault();
          const url = window.location.href;
          const text = 'Conheça a maquininha Ton: sem aluguel, sem mensalidade e com garantia vitalícia — ' + url;
          if (navigator.share) {
            navigator.share({ title: 'Maquininha Ton', text, url }).catch(() => {});
          } else {
            window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank', 'noopener');
          }
        });
      }
    </script>
    <CookieBanner />
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
    flex-wrap: nowrap;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    white-space: nowrap;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .brand span { color: var(--color-ton-dark); }
  .partner-logo { height: 1.9rem; width: auto; }
  .header-nav {
    margin-left: 0;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .header-nav a:not(.btn) {
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 1rem;
  }
  .header-nav a:not(.btn):hover { color: var(--color-ton-dark); }
  .header-cta { padding: 0.55rem 1.25rem; min-height: 44px; font-size: 0.9375rem; white-space: nowrap; }
  .share-fab {
    position: fixed;
    right: 1rem;
    bottom: 1.25rem;
    z-index: 110;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    display: grid;
    place-items: center;
    box-shadow: 0 4px 16px rgba(8, 19, 12, 0.28);
    text-decoration: none;
  }
  .share-fab:hover { background: #1fb958; transform: translateY(-2px); }
  .share-fab:focus-visible { outline: 3px solid var(--color-ton-dark); outline-offset: 2px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .footer-links a { font-size: 0.875rem; }
  @media (max-width: 760px) {
    .header-row { flex-wrap: nowrap; justify-content: center; }
    .header-nav { width: auto; margin-left: 0; gap: var(--space-2); }
    .nav-link { display: none; }
    .header-cta { margin-left: 0; }
  }
  @media (max-width: 380px) {
    .header-row { gap: var(--space-1); padding-inline: 0.75rem; }
    .brand { font-size: 1.05rem; }
    .partner-logo { height: 1.35rem; flex: 0 0 auto; }
    .header-cta { font-size: 0.75rem; padding: 0.4rem 0.7rem; min-height: 38px; flex: 0 0 auto; }
  }
</style>
