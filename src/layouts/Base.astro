---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — AnaliseReview</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/"><strong>AnaliseReview</strong></a>
        <img src="/parceiro-ton.png" alt="Parceiro Ton" class="partner-logo" />
        <a href="/metodologia">Metodologia</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <img src="/parceiro-ton.png" alt="Parceiro Ton" class="partner-logo" />
      <p class="legal">Declaramos, para todos os fins, que este canal é de titularidade de um Parceiro Renda Ton/Renda Extra, que oferece descontos para aquisição dos produtos e serviços do Ton. Este ambiente não se confunde com os canais oficiais do Ton.</p>
      <p class="site-link"><a href="https://www.ton.com.br" rel="noopener">Site oficial do Ton</a></p>
      <p class="copyright">© {new Date().getFullYear()} AnaliseReview</p>
    </footer>
    <CookieBanner />
  </body>
</html>

<style>
  header nav { display: flex; align-items: center; gap: var(--space-3); max-width: var(--measure); margin: 0 auto; padding: var(--space-3) var(--space-4); }
  .partner-logo { height: 1.5rem; width: auto; display: inline-block; }
  footer { max-width: var(--measure); margin: var(--space-6) auto 0; padding: var(--space-4); border-top: 1px solid var(--color-rule); font-size: 0.875rem; color: var(--color-muted); }
  .legal { font-size: 0.8125rem; }
  .site-link a { color: var(--color-accent); }
  .copyright { margin-top: var(--space-3); }
</style>
